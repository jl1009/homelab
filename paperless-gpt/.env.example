# Network and Deployment Environment
DOCKER_NETWORK=paperless_shared_net
PORT=8080
TZ=America/Los_Angeles
LOG_LEVEL=info

# Paperless Integration Settings
PAPERLESS_BASE_URL=http://webserver:8000
PAPERLESS_API_TOKEN=your_paperless_api_token_here
PAPERLESS_PUBLIC_URL=http://192.168.1.50:8000

# Azure Document Intelligence Settings (OCR -> Markdown)
OCR_PROVIDER=azure
AZURE_DOCAI_ENDPOINT=https://your-resource-name.cognitiveservices.azure.com/
AZURE_DOCAI_KEY=your_azure_docai_key_here
AZURE_DOCAI_MODEL_ID=prebuilt-layout
AZURE_DOCAI_OUTPUT_CONTENT_FORMAT=markdown
AZURE_DOCAI_TIMEOUT_SECONDS=120
OCR_PROCESS_MODE=whole_pdf

# Azure OpenAI Settings (LLM)
LLM_PROVIDER=openai
OPENAI_API_TYPE=azure
OPENAI_BASE_URL=https://your-resource-name.openai.azure.com/
OPENAI_API_KEY=your_azure_openai_key_here
LLM_MODEL=gpt-5.4-mini-1
LLM_LANGUAGE=English

# Workflow & Tagging Settings
MANUAL_TAG=paperless-gpt
AUTO_TAG=paperless-gpt-auto
FAIL_TAG=paperless-gpt-failed
AUTO_OCR_TAG=paperless-gpt-ocr-auto

# Enhanced OCR File Settings
PDF_UPLOAD=false
CREATE_LOCAL_PDF=false
CREATE_LOCAL_HOCR=false
PDF_SKIP_EXISTING_OCR=false
PDF_OCR_TAGGING=true
PDF_OCR_COMPLETE_TAG=paperless-gpt-ocr-complete

# Chaining OCR -> Classification
AUTO_OCR_THEN_CLASSIFY=true

# Metadata Auto-generation Controls
AUTO_GENERATE_TITLE=true
AUTO_GENERATE_DOCUMENT_TYPE=true
AUTO_GENERATE_TAGS=false
AUTO_GENERATE_CORRESPONDENTS=false
AUTO_GENERATE_CREATED_DATE=false
